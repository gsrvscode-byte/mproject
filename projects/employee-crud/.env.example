# Port the Express API listens on
PORT=5000

# --- PostgreSQL connection ---
#
# DATABASE_HOST explained:
#
# When you run the API on your OWN machine (Phase 1-2, `npm run dev`)
# and Postgres in a container with its port published to your machine,
# use "localhost":
#   DATABASE_HOST=localhost
#
# When the API ITSELF runs inside a Docker container alongside the
# Postgres container (Phase 5 onward, docker-compose), you MUST use
# the Docker Compose SERVICE NAME instead:
#   DATABASE_HOST=postgres
#
# See the README section "Understanding Docker Networking" for a full
# explanation of why "localhost" breaks once the API is containerized.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=employee_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
