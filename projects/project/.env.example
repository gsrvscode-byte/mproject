# Port the Express API listens on
PORT=5000

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# - When running locally with `npm run dev` (Postgres in Docker, API on host),
#   host is "localhost":
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsdb
#
# - When running the API itself inside docker-compose, host must be the
#   service name "postgres" instead of "localhost":
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/docsdb

# Your OpenAI API key (used for embeddings + chat completions via LangChain)
OPENAI_API_KEY=sk-your-key-here
